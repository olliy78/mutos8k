# passwd: getpass lies in front of the first strong match (like login)
+ getpass 04C8 05E2 data=1F32:1F40 bss=29B4:A exp=_getpass@04C8 src=G
# W10d: the commons are the ORIGINAL buffers, not members_auto's `bstart - 2 - 0x400` guess.  Measured: the _flsbuf/_filbuf
# literals of the original (#%25B2 stdin branch, #%27B2 stdout branch); the `#%OFF+__sibuf` forms were only relative to the wrong guess.
common __sibuf 25B2 200 data
common __sobuf 27B2 200 data
extern _environ 29B2 2
