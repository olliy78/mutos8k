; mutoscpa.mac - CP/A version of mutos_io (plan 48).
; Origin: byte-identical copy of mutos_io/src/mutosio.mac (branch main) at the commit of step C2.1;
; `git diff <that commit> -- mutos_io/cpa/src/mutoscpa.mac` shows all CP/A changes.
; Since step C3.2 the binary is deliberately NOT identical to mutosio.bin any more:
; start, stack, interrupt vectors, console output and operator mask use the CP/A BIOS (doc/plus/cpa/c3_2_start.md).
; Since step C3.3 the disk path is synchronous through the BIOS entries SELDSK/SETTRK/SETSEC/SETDMA/READ/WRITE
; (doc/plus/cpa/c3_3_platte.md); the printer is still a stub (until C4.1).
	.Z80
	CSEG

; N Fuellbytes FFH (UDOS-Segmente haben unbenutzte Luecken)
FILLFF	MACRO	N
	REPT	N
	DB	0FFH
	ENDM
	ENDM

; ---- Addresses as names (plan 48 C3.1; values unchanged, binary stays identical) ----
; Load segment bases (.PHASE)
SEG1_BASE	EQU	9000H
SEG2_BASE	EQU	9400H
SEG3_BASE	EQU	0A400H
SEG4_BASE	EQU	0C8B6H
; Stack (plan 48 C3.2): grows down from INITSP through STKBOT..INITSP-1 (0F80H bytes, painted with E5H at the start)
INITSP	EQU	SEG4_BASE
STKBOT	EQU	0B936H
; CP/A interrupt vector table (register I = F7H, checked at the start): vector slot address = INTVEC + vector byte
INTVEC	EQU	0F700H
; Copy of the 14-byte request message in the data segment: +0 class, +1 unit
V_NACHR	EQU	0A5A8H
; Z80 transfer buffers of the DCB/AUF tables (DCBn+2/+3, AUFn+2/+3)
BUF_DISK	EQU	0A8B6H
BUF_LIST	EQU	0A7B6H
BUF_RAWFD	EQU	0B8B6H
BUF_CONS	EQU	0A5B6H
BUF_TTY1	EQU	0A636H
BUF_TTY2	EQU	0A6B6H
BUF_TTY3	EQU	0A736H


; ---- Segment 9000H .. 922CH ----
	.PHASE	SEG1_BASE
SEG9000:
; ==========================================================================
; mutos_io - U880-Seite von MUTOS 8000 (Robotron A5120.16, Erweiterungsmodul EM)
; ==========================================================================
; UDOS-Programm (Typ P, Stand 16.01.1986) auf der Ladediskette; wird vom Skript MUTOS
; nach dem Kernel mutos_1216 (Z8000) gestartet.  Aufgabe: E/A-Prozessor des Kernels -
; Platte, Drucker, Konsole/Tastatur, serielle Leitungen laufen ueber den U880.
; 
; Ablauf (Messungen: doc/mutos_io/analyse.md, Entwurf 39 Abschnitt 11):
; 1. Der Kernel legt eine 14-Byte-NACHRICHT im EM-Speicher ab, ihren Zeiger bei
; EM-Offset 4006H, und setzt A33 Bit 4 (INT-16) -> PIO A32 -> ISR_ANFRAGE.
; 2. ISR_ANFRAGE kopiert die Nachricht in den Geraeteblock (DCB) und setzt das
; Anforderungsbit der Einheit in der Maske ihrer KLASSE.
; 3. HAUPT arbeitet die Klassen reihum ab und ruft den Handler der Einheit.
; 4. Der Handler fuehrt den Auftrag aus (Platte: UDOS-Nukleus 0BFDH; Konsole: 0BEBH).
; 5. MELDEN schreibt Status (+3) und Zaehlung (+8/9) in die Nachricht im EM und
; gibt den Vektor des DCB an den Z8000 (OUT ADH) - falls dessen Ebene es zulaesst.
; 
; Fuenf Klassen (Nachricht +0 = 2 * Klasse): 0 Platte, 1 Drucker, 2 Konsole/tty,
; 3 Roh-Floppy (im Betrieb nie benutzt), 4 Eingabe (Tastatur, SIO; nur intern).
; Ports (A5120.16): A8H..ABH PIO A32, ACH Status-8, ADH Vektor, AFH Attributspeicher;
; 0DH CTC (Takt), 50H..53H SIO, 5CH/5DH Tastatur-SIO; Ausfuehrung Entwurf 17 Abschnitt 7.
; 
; Bau: python3 mutos_io/build.py ; Diskette: ladediskette.py diskette ...
; Wartung: DIESE Datei ist der Master (von Hand aendern, dann build.py --check).
; Ausgangsstand: Abzug + karte.txt (z80_disasm2.py --format mac --karte); Karte nur noch Nachweis.
; 
	DI
	LD SP,INITSP
; paint the stack area (below SP, no CALL until it is done): the depth probe of C3.2/C4.2 looks for the last E5H
	LD HL,STKBOT
	LD DE,STKBOT+1
	LD BC,INITSP-STKBOT-1
	LD (HL),0E5H
	LDIR
	CALL BIOS_LINK		; BIOS jump list from (0001H), read once
	CALL CHECK_I		; I must be F7H (CP/A interrupt table)
	CALL KBD_FLUSH
	EI			; the BIOS interrupts (5 ms/1 s timers, clock) run from here on
	CALL MASKE
	CALL INIT
	LD A,2CH		; releases RESET16: the kernel in the EM starts
	OUT (0A9H),A
	XOR A
	LD (V_KLASSE),A
	CALL KLASSE_SETZEN
; --- HAUPT: Hauptschleife -------------------------------------------------
; IX = Beschreiber der laufenden Klasse (V_AKTUELL = KLASSEN + 4*k):
; +0 Anforderungsmaske (Bit n = Einheit n will bedient werden)
; +1 Fertigmaske       (Bit n = Einheit n ist fertig, Meldung an den Z8000)
; +2/3 Zeiger auf die Handlertabelle (8 x [DCB-Zeiger, Handler])
HAUPT:
	LD IX,(V_AKTUELL)	; Beschreiber der laufenden Klasse
	LD A,(IX+0)
	OR A
	JR Z,HAUPT_B
	CALL BIT_NUMMER	; C = niedrigste gesetzte Einheit
	CALL EINTRAG_HOLEN	; IX = DCB, HL = Handler
	JP (HL)
; Anforderungen dieser Klasse erledigt: naechste Klasse, nach Fertigmeldungen sehen
HAUPT_B:
	CALL KLASSE_WEITER
	LD IX,(V_AKTUELL)
	LD A,(IX+1)
	OR A
	JR Z,HAUPT_NEU
	CALL BIT_NUMMER
	CALL EINTRAG_HOLEN
	JP MELDEN
HAUPT_NEU:
	JR HAUPT
; --- MELDEN: Fertigmeldung einer Einheit an den Z8000 ---------------------
; IX = DCB.  IX+9 = Status (0 = laeuft noch -> nichts tun).  Zugestellt wird nur,
; wenn Befehl Bit 7 gesetzt ist (ohne Interrupt, Z8000 fragt den Status selbst ab)
; oder /VI = 1 (kein Vektor steht an) UND Ebene des Z8000 (A33 Bit 0-2) < IX+1.
; Sonst bleibt der Auftrag stehen und wird im naechsten Umlauf erneut versucht.
MELDEN:
	LD A,(IX+9)
	OR A
	JP Z,MEL_ENDE
	DI
	BIT 7,(IX+8)
	JR NZ,MEL_DATEN
	LD A,(IX+1)
	LD B,A
	IN A,(0A8H)
	BIT 3,A
	JR Z,MEL_ENDE
	AND 07H	; Ebene des Z8000 < DCB-Schwelle?
	CP B
	JR NC,MEL_ENDE
MEL_DATEN:
	LD A,(IX+8)	; Befehl lesen (0)? -> Daten Z80-Puffer -> EM
	AND 7FH
	CP 00H
	JR NZ,MEL_STATUS
	LD A,(IX+14)
	OR (IX+15)
	JR Z,MEL_STATUS
	CALL EM_PARAMETER
	EX DE,HL
	CALL EM_BUS
	LDIR
	LD A,2CH
	OUT (0A9H),A
; Ergebnis in die Nachricht im EM: +3 Status, +8/9 uebertragene Zahl
MEL_STATUS:
	LD L,(IX+4)
	LD H,(IX+5)
	CALL SEITE_ABBILDEN
	LD BC,0003H
	ADD HL,BC
	LD B,(IX+9)
	LD D,(IX+14)
	LD E,(IX+15)
	XOR A
	CALL EM_BUS
	LD (HL),B
	LD BC,0005H
	ADD HL,BC
	LD (HL),D
	INC HL
	LD (HL),E
	BIT 7,(IX+8)
	JR NZ,MEL_IRQ
	LD A,(IX+0)
	OUT (0ADH),A	; OUT ADH: Vektor -> VI an den U8001
; Vektor des DCB an den Z8000, dann Auftrag beendet (IX+22 Bit 0 loeschen)
MEL_IRQ:
	LD A,2CH
	OUT (0A9H),A
	LD HL,(V_AKTUELL)
	INC HL
	LD A,(IX+7)
	CALL BIT_LOESCHEN
	RES 0,(IX+22)
MEL_ENDE:
	EI
	JP HAUPT_NEU
; --- EING_TASTE: Klasse 4 Einheit 0: Tastenzeichen an den Z8000 ----------
; Zeichen aus dem Ring QUEUE_TASTE; Ebene < 4 und /VI frei erforderlich.
; Zeichen -> Status-8 (ACH), Vektor 22H -> ADH.  Ring leer: Anforderungsbit loeschen.
EING_TASTE:
	DI
	IN A,(0A8H)
	BIT 3,A
	JR Z,ET_ENDE
	AND 07H
	CP 04H
	JR NC,ET_ENDE
	LD HL,QUEUE_TASTE
	CALL QUEUE_POP
	JR Z,ET_LEER
	OUT (0ACH),A
	LD A,22H
	OUT (0ADH),A
	JR ET_ENDE
ET_LEER:
	LD A,00H
	LD HL,(V_AKTUELL)
	CALL BIT_LOESCHEN
ET_ENDE:
	EI
	JP HAUPT_B
; Warteschlange der Tastatur leeren (04 04 00 00)
WARTESCHL0_INIT:
	LD HL,QUEUE_TASTE
	CALL QUEUE_INIT
	RET
; --- DRUCKER: class 1 (STUB until C4.1): status FFH (error) at once, request done ------
DRUCKER:
	LD (IX+9),0FFH
	JP ENDE_WIEDER
; DRUCKER_FERTIG: callback of the UDOS printer driver; unused until C4.1
DRUCKER_FERTIG:
	DI
	CALL REGS_RETTEN
	LD IX,DCB1
	LD A,(AUF1_STATUS)
	BIT 6,A
	JR Z,DF_OK
	LD A,0FFH
	JR DF_STATUS
DF_OK:
	LD A,01H
DF_STATUS:
	LD (IX+9),A
	DI
	LD HL,KLASSE1_MELDUNG
	LD A,(IX+7)
	CALL BIT_SETZEN
	CALL REGS_HOLEN
	EI
	RET
; --- KONSOLE_AUS: class 2 unit 0: each character through PUTC (BIOS CONOUT) ----
KONSOLE_AUS:
	LD L,(IX+2)
	LD H,(IX+3)
	LD B,(IX+14)
	LD C,(IX+15)
	PUSH IX
KA_ZEICHEN:
	PUSH HL
	PUSH BC
	LD A,(HL)
	CALL PUTC
	POP BC
	POP HL
	INC HL
	DEC BC
	LD A,C
	OR B
	JR NZ,KA_ZEICHEN
	POP IX
	LD (IX+9),01H
	JP ENDE_WIEDER
SEG9000E:
	REPT	(100H-(($-SEG9000) AND 0FFH)) AND 0FFH
	DB	0FFH
	ENDM
	.DEPHASE

; ---- Segment 9400H .. A2AFH ----
	.PHASE	SEG2_BASE
SEG9400:
; --- INIT: Hardware-Initialisierung --------------------------------------
; Attributspeicher (AFH): alle 16 Seiten := 0FH (gesperrt; Attribute sind negiert).
; PIO A32: Port A Vektor EAH, Modus 3, Eingang, Interrupt bei INT-16 (Bit 4);
; Port B Vektor ECH, Interrupt bei /PE (Bit 7, Paritaetsfehler).  CTC 0DH Kanal 1:
; A7H/C0H = Zeitgeber 50 Hz.  Vector slots in the CP/A table (INTVEC = F700H, I = F7H):
; PIO A -> +0EAH, PIO B -> +0ECH, CTC channel 1 -> +0FAH (the CTC base F8H stays the BIOS one), SIO -> +30H..+3EH.
; Dann Tastatur, Warteschlangen, SIO.
INIT:
	LD E,10H
	LD BC,00AFH
INIT_ATTR:
	LD A,0FH
	OUT (C),A
	LD A,10H
	ADD A,B
	LD B,A
	DEC E
	JR NZ,INIT_ATTR
	LD HL,ISR_ANFRAGE
	LD (INTVEC+0EAH),HL
	LD HL,ISR_PARITAET
	LD (INTVEC+0ECH),HL
	LD C,0AAH
	LD B,05H
	LD HL,TAB_PIO_A
	OTIR
	LD C,0ABH
	LD B,05H
	LD HL,TAB_PIO_B
	OTIR
	LD HL,ISR_TAKT
	LD (INTVEC+0FAH),HL
	LD A,0A7H
	OUT (0DH),A
	LD A,0C0H
	OUT (0DH),A
	CALL INIT_TASTATUR
	CALL WARTESCHL0_INIT
	CALL INIT_TTY1
	CALL INIT_TTY2
	CALL INIT_TTY3
	RET
; Tastatur: CTC 58H Kanal 0 Zeitkonstante 1 (9600 Baud), SIO 5CH/5DH polled, 8 Bit
INIT_TASTATUR:
	LD A,05H
	OUT (58H),A
	LD A,01H
	OUT (58H),A
	LD C,5DH
	LD B,0CH
	LD HL,TAB_TASTATUR_SIO
	OTIR
	XOR A
	OUT (5CH),A
	LD A,07H
	OUT (5CH),A
	RET
TAB_TASTATUR_SIO:
	DB	00H,18H,02H,08H,01H,00H,04H,44H,05H,68H,03H,0C1H
TAB_PIO_A:
	DB	0EAH,0CFH,0FFH,0B7H,0EFH
TAB_PIO_B:
	DB	0ECH,0CFH,80H,97H,7FH
; --- ISR_TAKT: Zeitgeber 50 Hz (CTC 0DH Kanal 1) --------------------------
; Counts V_TAKT and reports the tick counter (ACH) with vector 02H when the level is < 6
; and /VI is free.  No keyboard polling since C3.2 (the BIOS owns 5CH/5DH; C3.4 reads keys via CONST/CONIN).
ISR_TAKT:
	CALL REGS_RETTEN
	LD HL,V_TAKT
	INC (HL)
	IN A,(0A8H)
	BIT 3,A
	JR Z,IT_ENDE
	AND 07H
	CP 06H
	JR NC,IT_ENDE
	LD A,(HL)
	OUT (0ACH),A
	LD A,02H
	OUT (0ADH),A
	XOR A
	LD (HL),A
IT_ENDE:
	CALL REGS_HOLEN
	EI
	RETI
; --- ISR_PARITAET: Paritaetsfehler (PIO B Bit 7): PR-Impuls loescht das FF ---
ISR_PARITAET:
	PUSH AF
	LD A,6CH
	OUT (0A9H),A
	LD A,2CH
	OUT (0A9H),A
	POP AF
	EI
	RETI
; --- ISR_ANFRAGE: der Z8000 hat eine Nachricht abgelegt (INT-16) -----------
; Zeiger holen aus EM-Seite 4 Offset 6 (4006H), Zeiger loeschen, 14 Byte Nachricht
; nach A5A8, Byte 0 waehlt den Beschreiber (KLASSE_ADR), Byte 1 den DCB (EINTRAG_HOLEN),
; Nachricht nach DCB+6, IX+22 Bit 0 'Auftrag laeuft'; Befehl 1 (schreiben): Daten sofort
; EM -> Z80-Puffer; Anforderungsbit der Einheit setzen.
ISR_ANFRAGE:
	CALL REGS_RETTEN
	LD BC,40AFH
	LD A,0CH
	OUT (C),A
	LD DE,0000H
	XOR A
	CALL EM_BUS
	LD HL,(4006H)
	LD (4006H),DE
	LD A,2CH
	OUT (0A9H),A
	LD A,H
	LD H,L
	LD L,A
	PUSH HL
	CALL SEITE_ABBILDEN
	LD DE,V_NACHR
	LD BC,000EH
	XOR A
	CALL EM_BUS
	LDIR
	LD A,2CH
	OUT (0A9H),A
	LD A,(V_NACHR)
	CALL KLASSE_ADR
	LD (V_ANFRAGE_EINTRAG),HL
	LD IX,(V_ANFRAGE_EINTRAG)
	LD A,(V_NACHR+1)
	LD C,A
	CALL EINTRAG_HOLEN
	PUSH IX
	POP HL
	LD BC,0006H
	ADD HL,BC
	LD DE,V_NACHR
	EX DE,HL
	LD BC,000EH
	BIT 0,(IX+22)
	JR Z,IA_KOPIE
	LD A,(HL)
	CP 04H
	JR NZ,IA_BELEGT
	PUSH IX
	PUSH HL
	POP IX
	LD A,(IX+1)
	CP 00H
	JR NZ,IA_BELEGT
	BIT 7,(IX+2)
	JR NZ,IA_OK
IA_BELEGT:
	LD A,'B'		; second request hits a busy DCB
	JP FEHLERHALT
IA_OK:
	POP IX
IA_KOPIE:
	LDIR
	SET 0,(IX+22)
	POP HL
	LD (IX+4),L
	LD (IX+5),H
	LD A,(IX+8)
	AND 7FH
	CP 01H
	JR NZ,IA_ZAEHLER
	CALL EM_PARAMETER
	CALL EM_BUS
	LDIR
	LD A,2CH
	OUT (0A9H),A
IA_ZAEHLER:
	LD B,(IX+14)
	LD C,(IX+15)
	LD (IX+20),B
	LD (IX+21),C
	LD HL,(V_ANFRAGE_EINTRAG)
	LD A,(V_NACHR+1)
	CALL BIT_SETZEN
	CALL REGS_HOLEN
	EI
	RETI
	FILLFF	141
; --- Klassen-Verwaltung ----------------------------------------------------
; V_KLASSE zaehlt 0,2,4,6,8 (je 4 Byte Beschreiber); V_AKTUELL zeigt auf KLASSEN+...
KLASSE_WEITER:
	LD A,(V_KLASSE)
	INC A
	INC A
	CP 0AH
	JR C,KLASSE_SETZEN
	XOR A
KLASSE_SETZEN:
	LD (V_KLASSE),A
	CALL KLASSE_ADR
	LD (V_AKTUELL),HL
	RET
; HL := KLASSEN + 2*A (A = 2*Klasse -> 4 Byte je Beschreiber)
KLASSE_ADR:
	SLA A
	LD HL,KLASSEN
	LD B,00H
	LD C,A
	ADD HL,BC
	RET
; C := Nummer des niedrigsten gesetzten Bits von A
BIT_NUMMER:
	LD C,0FFH
BN_SCHL:
	INC C
	RRA
	JR NC,BN_SCHL
	RET
; IX := DCB und HL := Handler der Einheit C aus der Tabelle (IX+2/3 + 4*C)
EINTRAG_HOLEN:
	SLA C
	SLA C
	LD B,00H
	LD L,(IX+2)
	LD H,(IX+3)
	ADD HL,BC
	LD E,(HL)
	INC HL
	LD D,(HL)
	INC HL
	PUSH DE
	POP IX
	LD E,(HL)
	INC HL
	LD D,(HL)
	EX DE,HL
	RET
; Bit (A and 7) im Byte (HL) setzen
BIT_SETZEN:
	AND 07H
	LD B,A
	LD A,80H
BS_SCHL:
	RLCA
	DEC B
	JP P,BS_SCHL
	OR (HL)
	LD (HL),A
	RET
; Bit (A and 7) im Byte (HL) loeschen
BIT_LOESCHEN:
	AND 07H
	LD B,A
	LD A,7FH
BL_SCHL:
	RLCA
	DEC B
	JP P,BL_SCHL
	AND (HL)
	LD (HL),A
	RET
; Auftrag fertig: Anforderungsbit loeschen, Fertigbit setzen, zurueck in die Schleife
ENDE_WIEDER:
	DI
	LD HL,(V_AKTUELL)
	LD A,(IX+7)
	CALL BIT_LOESCHEN
	INC HL
	LD A,(IX+7)
	CALL BIT_SETZEN
	EI
	JP HAUPT_B
; Anforderungsbit loeschen (Auftrag laeuft im Nukleus weiter)
ENDE_LOESCHEN:
	DI
	LD HL,(V_AKTUELL)
	LD A,(IX+7)
	CALL BIT_LOESCHEN
	EI
	JP HAUPT_B
; Leerhandler fuer Einheiten ohne Geraet (im Betrieb nie angefordert)
IGNORIEREN:
	DI
	LD HL,(V_AKTUELL)
	LD A,(IX+7)
	CALL BIT_LOESCHEN
	INC HL
	LD A,(IX+7)
	CALL BIT_LOESCHEN
	EI
	JP HAUPT_B
; --- EM-Zugriff -------------------------------------------------------------
; SEITE_ABBILDEN: EM-Adresse HL auf das Z80-Fenster 4000H-7FFFH abbilden: zwei benachbarte
; 4-KB-Seiten ueber OUT (C),A an AFH (B = Seite); A14/A15 der EM-Adresse kommen aus dem
; Attribut.  Rueckgabe HL = Fensteradresse.
SEITE_ABBILDEN:
	LD A,H
	AND 30H
	OR 40H
	LD B,A
	LD C,0AFH
	LD A,H
	CPL
	AND 0C0H
	RRCA
	RRCA
	RRCA
	RRCA
	OUT (C),A
	LD A,B
	ADD A,10H
	LD B,A
	LD A,H
	ADD A,10H
	CPL
	AND 0C0H
	RRCA
	RRCA
	RRCA
	RRCA
	OUT (C),A
	LD A,H
	AND 3FH
	OR 40H
	LD H,A
	RET
; EM_PARAMETER: HL = Fenster der Nachricht, BC = Zaehlung, DE = Z80-Puffer, A = Segment
EM_PARAMETER:
	LD H,(IX+12)
	LD L,(IX+13)
	CALL SEITE_ABBILDEN
	LD B,(IX+14)
	LD C,(IX+15)
	LD D,(IX+3)
	LD E,(IX+2)
	LD A,(IX+11)
	RET
; EM_BUS: Segment A (0-3) waehlen, /TRQ8 aktiv (OUT A9H = 48H+n) und warten, bis der
; U880 den Bus hat (IN A8H Bit 6)
EM_BUS:
	AND 03H
	OR 48H
	OUT (0A9H),A
EB_WARTEN:
	IN A,(0A8H)
	BIT 6,A
	RET NZ
	JR EB_WARTEN
; --- Warteschlangen (Ringe QUEUE_*: +0 Schreib-, +1 Leseindex, Daten ab +4 bis 2BH) ---
; QUEUE_PUSH: Zeichen A in den Ring HL
QUEUE_PUSH:
	LD B,A
	LD C,(HL)
	CALL QUEUE_WEITER
	LD A,B
	LD B,00H
	ADD HL,BC
	LD (HL),A
	RET
; QUEUE_POP: Z = leer, sonst A = naechstes Zeichen
QUEUE_POP:
	LD A,(HL)
	INC HL
	XOR (HL)
	RET Z
	LD C,(HL)
	CALL QUEUE_WEITER
	DEC HL
	LD B,00H
	ADD HL,BC
	LD A,(HL)
	OR A
	RET
; Index weiterschalten, Umlauf bei 2BH auf 04
QUEUE_WEITER:
	LD A,2BH
	INC (HL)
	CP (HL)
	RET NC
	LD (HL),04H
	RET
; Ring initialisieren (04 04 00 00)
QUEUE_INIT:
	LD A,04H
	LD (HL),A
	INC HL
	LD (HL),A
	INC HL
	XOR A
	LD (HL),A
	INC HL
	LD (HL),A
	RET
; --- TASTE_LESEN: UNUSED since C3.2 (to be removed in C3.4); polls the keyboard SIO 5DH/5CH ---
; Tastatur-SIO 5DH Bit 0 = Zeichen da, 5CH holen; FFH -> CR
; Codes < 20H ueber TAB_TASTE, Praefix 9xH/BxH, Codes ab 80H verworfen.  Z = nichts.
TASTE_LESEN:
	IN A,(5DH)
	AND 01H
	JR Z,TL_NICHTS
	IN A,(5CH)
	CP 0FFH
	JR NZ,TL_ZEICHEN
	LD A,0DH
	JR TL_FERTIG
TL_ZEICHEN:
	LD B,A
	AND 0F0H
	CP 90H
	JR Z,TL_9X
	CP 0B0H
	JR Z,TL_BX
	LD A,B
	CP 80H
	JR NC,TL_NICHTS
TL_UMSETZEN:
	CP 20H
	JR NC,TL_FERTIG
	LD HL,TAB_TASTE
	LD B,00H
	LD C,A
	ADD HL,BC
	LD A,(HL)
TL_FERTIG:
	OR A
	RET
TL_NICHTS:
	XOR A
	RET
TL_9X:
	LD A,B
	AND 0FH
	JR TL_UMSETZEN
TL_BX:
	LD A,B
	AND 1FH
	JR TL_UMSETZEN
; REGS_RETTEN / REGS_HOLEN: AF, BC, DE, IX (und HL) fuer ISRs und Rueckrufe sichern
REGS_RETTEN:
	EX (SP),HL
	PUSH AF
	PUSH BC
	PUSH DE
	PUSH IX
	JP (HL)
REGS_HOLEN:
	POP HL
	POP IX
	POP DE
	POP BC
	POP AF
	EX (SP),HL
	RET
; Tastencode-Tabelle fuer Codes 00H-1FH (Steuerzeichen -> ASCII)
TAB_TASTE:
	DB	00H,09H,02H,03H,04H,05H,7FH,07H,7FH,09H,0AH,0BH,0CH,0DH,0EH,0FH
	DB	10H,11H,12H,15H,14H,15H,16H,17H,18H,19H,1AH,7FH,1CH,1DH,1EH,0FFH
	FILLFF	139
; --- DISK (class 0): synchronous through the CP/A BIOS (plan 48 C3.3, doc/plus/cpa/c3_3_platte.md) ------
; The Z8000 asks for `count` bytes (IX+14 = high byte, IX+15 = low byte, a multiple of 128) of kernel
; block `bn` (IX+18 = high, IX+19 = low) of unit IX+7 (0..7), command IX+8 and 7FH = 1 write, else read;
; data in the Z80 buffer IX+2/3.  A request spans consecutive 128-byte records l = 4*bn + j.
; Per record SETTRK / SETSEC / SETDMA / READ or WRITE (BIOS jump list, never SECTRAN).  The record number of
; SETSEC is the MUTOS sector ID (26 x 128: interleave 2, track skew 6) turned into the BIOS record number
; (doc/plus/cpa_analyse.md section 4): on tracks >= OFF (DPB+13) INV[ID], below OFF the ID itself;
; 8 x 512 (SPT 32 or 36 in the DPB): record = (l mod 32) + 1 on track l div 32 + 1.
; Result as in the UDOS version: IX+9 = 1 (good) or C0H (error, bit 6 set), IX+14/15 = transferred count.
; The BIOS may change IX: all message fields are copied to V_* first, IX := DCB0 again at the end.
; Unit -> CP/A drive: TAB_RK_LAUFWERK (mask: unit -> floppy 0..3) then TAB_RK_CPA[floppy]; units 4..7 index
; TAB_RK_CPA directly (FFH = no drive; plans 49/51 enter their drives there).
PLATTE:
	LD A,(IX+14)
	CP 11H
	JR C,PL_GROSS
	LD A,'L'		; disk request longer than 1000H bytes (as the UDOS version)
	JP FEHLERHALT
PL_GROSS:
	ADD A,A			; record count = 2*high + bit 7 of low
	LD B,A
	LD A,(IX+15)
	RLCA
	AND 01H
	ADD A,B
	LD (V_NREC),A
	LD A,(IX+8)
	AND 7FH
	LD (V_CMD),A
	LD A,(IX+18)
	LD (V_BN+1),A
	LD A,(IX+19)
	LD (V_BN),A
	LD L,(IX+2)
	LD H,(IX+3)
	LD (V_DMA),HL
	LD A,(IX+7)
	LD (V_UNIT),A
	CP 04H
	JR NC,PL_INDEX		; units 4..7: TAB_RK_CPA index = unit
	LD E,A
	LD D,00H
	LD HL,TAB_RK_LAUFWERK
	ADD HL,DE
	LD A,(HL)		; floppy drive 0..3 chosen in the mask
PL_INDEX:
	AND 07H
	LD E,A
	LD D,00H
	LD HL,TAB_RK_CPA
	ADD HL,DE
	LD A,(HL)
	CP 0FFH
	JP Z,PL_FEHLER		; no CP/A drive behind this unit
	LD (V_CPA),A
; log in: first access after the mask E bit 0 = 0 (format detection), then E = 1
	LD A,(V_UNIT)
	LD E,A
	LD D,00H
	LD HL,V_ANGEM
	ADD HL,DE
	LD E,00H
	LD A,(HL)
	OR A
	JR Z,PL_SELDSK
	LD E,01H
PL_SELDSK:
	LD A,(V_CPA)
	LD C,A
	CALL B_SELDSK
	LD A,H
	OR L
	JP Z,PL_FEHLER		; HL = 0: drive not usable
	PUSH HL
	LD A,(V_UNIT)
	LD E,A
	LD D,00H
	LD HL,V_ANGEM
	ADD HL,DE
	LD (HL),01H		; logged in
	POP HL
; DPH+10 -> DPB: SPT (word at +0) and OFF (byte at +13), read after every SELDSK
	LD DE,000AH
	ADD HL,DE
	LD E,(HL)
	INC HL
	LD D,(HL)
	EX DE,HL
	LD E,(HL)
	INC HL
	LD D,(HL)		; DE = SPT
	LD BC,000CH
	ADD HL,BC		; DPB+13
	LD A,(HL)
	LD (V_OFF),A
	LD A,D
	OR A
	JP NZ,PL_FEHLER
	LD A,E
	LD B,26
	CP 26
	JR Z,PL_FORMAT		; 26 x 128
	LD B,32
	CP 32
	JR Z,PL_FORMAT		; 8 x 512
	CP 36
	JP NZ,PL_FEHLER		; 8 x 512 as detected by the BIOS (9 x 512)
PL_FORMAT:
	LD A,B
	LD (V_PERTRK),A		; records per track as MUTOS counts them
; start position: l = 4*bn, track q = l div PERTRK, pos = l mod PERTRK, skew = 6*q mod 26
	LD HL,(V_BN)
	LD A,H
	CP 40H
	JP NC,PL_FEHLER		; bn >= 4000H: l would not fit in 16 bits
	ADD HL,HL
	ADD HL,HL
	LD E,B
	LD D,00H
	XOR A
	LD (V_TRK),A
	LD (V_SKEW),A
PL_DIV:
	OR A
	SBC HL,DE
	JR C,PL_DIVEND
	LD A,(V_TRK)
	INC A
	JP Z,PL_FEHLER		; cylinder > 255
	LD (V_TRK),A
	LD A,(V_SKEW)
	ADD A,06H
	CP 26
	JR C,PL_SKEW
	SUB 26
PL_SKEW:
	LD (V_SKEW),A
	JR PL_DIV
PL_DIVEND:
	ADD HL,DE
	LD A,L
	LD (V_POS),A
	XOR A
	LD (V_K),A
; ---- record loop
PL_LOOP:
	LD A,(V_NREC)
	OR A
	JR Z,PL_GUT
	LD A,(V_TRK)
	INC A
	LD C,A			; cylinder = q + 1
	LD B,00H
	CALL B_SETTRK
	CALL PL_RECORD		; C = BIOS record number
	LD B,00H
	CALL B_SETSEC
	LD BC,(V_DMA)
	CALL B_SETDMA
	LD A,(V_CMD)
	CP 01H
	JR Z,PL_WRITE
	CALL B_READ
	JR PL_ERG
PL_WRITE:
	LD C,01H		; WRITE type: 1 = write through now, 0 = may be deferred by the BIOS blocking
	LD A,(V_K)
	CP 03H
	JR Z,PL_WRC		; last record of a block
	LD A,(V_NREC)
	CP 01H
	JR Z,PL_WRC		; last record of the request
	LD C,00H
PL_WRC:
	CALL B_WRITE
PL_ERG:
	OR A
	JP NZ,PL_FEHLER
; next record: DMA + 128, pos + 1 (at PERTRK: next track, skew + 6 mod 26), k + 1, count - 1
	LD HL,(V_DMA)
	LD DE,0080H
	ADD HL,DE
	LD (V_DMA),HL
	LD A,(V_K)
	INC A
	AND 03H
	LD (V_K),A
	LD HL,V_NREC
	DEC (HL)
	LD A,(V_POS)
	INC A
	LD HL,V_PERTRK
	CP (HL)
	JR C,PL_POS
	XOR A
	LD HL,V_TRK
	INC (HL)
	LD HL,V_SKEW
	LD B,A
	LD A,(HL)
	ADD A,06H
	CP 26
	JR C,PL_SKEW2
	SUB 26
PL_SKEW2:
	LD (HL),A
	LD A,B
PL_POS:
	LD (V_POS),A
	JR PL_LOOP
PL_GUT:
	LD IX,DCB0
	LD A,(IX+15)
	AND 80H
	LD (IX+15),A		; transferred count = requested count in whole records
	LD (IX+9),01H
	JP ENDE_WIEDER
PL_FEHLER:
	LD IX,DCB0
	LD (IX+9),0C0H		; error status (bit 6 set like a nucleus error)
	XOR A
	LD (IX+14),A
	LD (IX+15),A		; MELDEN then copies no data
	JP ENDE_WIEDER
; PL_RECORD: C = BIOS record number (SETSEC) of the current position
PL_RECORD:
	LD A,(V_PERTRK)
	CP 32
	JR Z,PR_512
	LD A,(V_POS)		; 26 x 128: ID = ((x + skew) mod 26) + 1, x = 2*pos (+1 when >= 26)
	ADD A,A
	CP 26
	JR C,PR_1
	INC A
PR_1:
	LD B,A
	LD A,(V_SKEW)
	ADD A,B
PR_2:
	CP 26
	JR C,PR_3
	SUB 26
	JR PR_2
PR_3:
	INC A			; MUTOS sector ID 1..26
	LD C,A
	LD A,(V_TRK)
	INC A			; cylinder
	LD HL,V_OFF
	CP (HL)
	RET C			; below OFF: the BIOS does not skew, record = ID
	LD B,00H
	LD HL,INVT-1
	ADD HL,BC
	LD C,(HL)		; record = INV[ID]
	RET
PR_512:
	LD A,(V_POS)
	INC A
	LD C,A
	RET
; INV[ID] = record r with SKEW[r-1] = ID (CP/A skew table of biosdpb.mac:374 inverted), ID = 1..26
INVT:
	DB	1,14,10,23,6,19,2,15,11,24,7,20,3,16,12,25,8,21,4,17,13,26,9,22,5,18
; CP/A drive of floppy 0..3 (mask result) / unit 4..7; FFH = none
TAB_RK_CPA:
	DB	00H,01H,02H,03H,0FFH,0FFH,0FFH,0FFH
; work variables of PLATTE
V_ANGEM:
	DB	00H,00H,00H,00H,00H,00H,00H,00H	; per unit: logged in since the mask
V_UNIT:
	DB	00H
V_CPA:
	DB	00H
V_CMD:
	DB	00H
V_NREC:
	DB	00H
V_BN:
	DW	0000H
V_DMA:
	DW	0000H
V_OFF:
	DB	00H
V_PERTRK:
	DB	00H
V_TRK:
	DB	00H
V_POS:
	DB	00H
V_SKEW:
	DB	00H
V_K:
	DB	00H
; --- ROH: class 3, raw floppy commands (never used in operation; STUB since C3.2) ------
; The original wrote the UDOS nucleus block at 01B5H and started the (unassigned) port 1CH;
; both are gone.  Every request is answered at once with the error status C1H (as the original
; reported an unknown command), count 0.
ROH:
	LD (IX+9),0C1H
	XOR A
	LD (IX+14),A
	LD (IX+15),A
	JP ENDE_WIEDER
; --- Eingabe-Handler Klasse 4 Einheit 1..3: Zeichen der seriellen Leitungen ----------
; HL = Ring, B = Vektor an den Z8000 (26H/2AH/2EH), C = Einheit; im Betrieb nie gelaufen
EING_TTY1:
	LD HL,QUEUE_TTY1
	LD B,26H
	LD C,01H
	JR EING_ZEICHEN
EING_TTY2:
	LD HL,QUEUE_TTY2
	LD B,2AH
	LD C,02H
	JR EING_ZEICHEN
EING_TTY3:
	LD HL,QUEUE_TTY3
	LD B,2EH
	LD C,03H
EING_ZEICHEN:
	DI
	IN A,(0A8H)
	BIT 3,A
	JR Z,EZ_ENDE
	AND 07H
	CP 04H
	JR NC,EZ_ENDE
	PUSH BC
	CALL QUEUE_POP
	POP BC
	JR Z,EZ_LEER
	OUT (0ACH),A
	LD A,B
	OUT (0ADH),A
	JR EZ_ENDE
EZ_LEER:
	LD A,C
	LD HL,(V_AKTUELL)
	CALL BIT_LOESCHEN
EZ_ENDE:
	EI
	JP HAUPT_B
; Ringe der Leitungen tty1..tty3 initialisieren; SIO initialisieren
INIT_TTY1:
	LD HL,QUEUE_TTY1
	CALL QUEUE_INIT
	CALL INIT_SIO
	RET
INIT_TTY2:
	LD HL,QUEUE_TTY2
	CALL QUEUE_INIT
	RET
INIT_TTY3:
	LD HL,QUEUE_TTY3
	CALL QUEUE_INIT
	RET
; --- Klasse 2 Einheit 1..3: serielle Ausgabe (alle ueber SIO Kanal A!) ------------
TTY1_AUS:
	LD IY,AUF3
	LD HL,TTY1_FERTIG
	JR TTY_AUS
TTY2_AUS:
	LD IY,AUF4
	LD HL,TTY2_FERTIG
	JR TTY_AUS
TTY3_AUS:
	LD IY,AUF5
	LD HL,TTY3_FERTIG
; TTY_AUS: Auftrag fuer SIO_SENDEN aufbauen (IY = AUF3..AUF5), HL = Fertig-Rueckruf
TTY_AUS:
	LD (IY+1),0FH
	LD A,(IX+2)
	LD (IY+2),A
	LD A,(IX+3)
	LD (IY+3),A
	LD A,(IX+14)
	LD (IY+5),A
	LD A,(IX+15)
	LD (IY+4),A
	LD (IY+6),L
	LD (IY+7),H
	LD (IY+8),L
	LD (IY+9),H
	PUSH IX
	CALL SIO_SENDEN
	POP IX
	JP ENDE_LOESCHEN
TTY1_FERTIG:
	DI
	CALL REGS_RETTEN
	LD IX,DCB4
	LD A,(AUF3_STATUS)
	JR TF_STATUS
TTY2_FERTIG:
	DI
	CALL REGS_RETTEN
	LD IX,DCB5
	LD A,(AUF4_STATUS)
	JR TF_STATUS
TTY3_FERTIG:
	DI
	CALL REGS_RETTEN
	LD IX,DCB6
	LD A,(AUF5_STATUS)
TF_STATUS:
	BIT 6,A
	JR Z,TF_OK
	LD A,0FFH
	JR TF_MELDEN
TF_OK:
	LD A,01H
TF_MELDEN:
	LD (IX+9),A
	DI
	LD HL,KLASSE2_MELDUNG
	LD A,(IX+7)
	CALL BIT_SETZEN
	CALL REGS_HOLEN
	EI
	RET
; --- INIT_SIO: SIO 50H-53H: 7 Bit, ungerade Paritaet, 1 Stopp, x16; CTC 5AH Kanal 2 = 9600 Baud ---
; IM-2 table INTVEC+30H..3EH: channel B Tx/Rx, channel A Tx/Rx
INIT_SIO:
	LD A,07H
	OUT (5AH),A
	LD A,01H
	OUT (5AH),A
	LD B,09H
	LD C,51H
	LD HL,TAB_SIO_A
	OTIR
	LD B,0BH
	LD C,53H
	LD HL,TAB_SIO_B
	OTIR
	LD DE,ISR_SIO_B_TX
	LD (INTVEC+30H),DE
	LD DE,ISR_SIO_B_RX
	LD (INTVEC+32H),DE
	LD (INTVEC+34H),DE
	LD (INTVEC+36H),DE
	LD DE,ISR_SIO_A_TX
	LD (INTVEC+38H),DE
	LD DE,ISR_SIO_A_RX
	LD (INTVEC+3AH),DE
	LD (INTVEC+3CH),DE
	LD (INTVEC+3EH),DE
	RET
TAB_SIO_A:
	DB	18H,04H,45H,05H,28H,03H,41H,01H,1EH
TAB_SIO_B:
	DB	18H,02H,30H,04H,45H,05H,28H,03H,41H,01H,1EH
; --- ISR_SIO_A_RX / ISR_SIO_B_RX: Zeichen in Ring QUEUE_TTY1 / QUEUE_TTY2, Klasse 4 melden ---
ISR_SIO_A_RX:
	CALL REGS_RETTEN
	IN A,(51H)
	BIT 0,A
	JR Z,ISA_ENDE
	IN A,(50H)
	AND 7FH
	LD HL,QUEUE_TTY1
	CALL QUEUE_PUSH
	LD A,08H
	CALL KLASSE_ADR
	LD A,01H
	CALL BIT_SETZEN
ISA_ENDE:
	CALL REGS_HOLEN
	EI
	RETI
ISR_SIO_B_RX:
	CALL REGS_RETTEN
	IN A,(53H)
	BIT 0,A
	JR Z,ISB_ENDE
	IN A,(52H)
	AND 7FH
	LD HL,QUEUE_TTY2
	CALL QUEUE_PUSH
	LD A,08H
	CALL KLASSE_ADR
	LD A,02H
	CALL BIT_SETZEN
ISB_ENDE:
	CALL REGS_HOLEN
	EI
	RETI
; --- SIO_SENDEN: Zeichenfolge (Zeiger/Zaehler in V_SIO_*) senden; Tx-leer-ISR sendet weiter ---
; Gesendet wird IMMER ueber Kanal A (50H/51H), auch fuer tty2/tty3 (Befund, nicht beabsichtigt?)
SIO_SENDEN:
	LD (V_SIO_IY),IY
	LD L,(IY+2)
	LD H,(IY+3)
	LD (V_SIO_ZEIGER),HL
	LD L,(IY+4)
	LD H,(IY+5)
	LD (V_SIO_REST),HL
	DI
	CALL SIO_BYTE
	EI
	RET
SIO_BYTE:
	LD (V_SIO_IY2),IY
	LD IY,(V_SIO_IY)
	LD BC,(V_SIO_REST)
	LD A,B
	OR C
	JR Z,SB_OK
	IN A,(51H)
	BIT 2,A
	JR Z,SB_ERR
	LD HL,(V_SIO_ZEIGER)
	LD A,(HL)
	INC HL
	LD (V_SIO_ZEIGER),HL
	OUT (50H),A
	DEC BC
	LD (V_SIO_REST),BC
	LD IY,(V_SIO_IY2)
	LD A,01H
	OR A
	RET
SB_ERR:
	LD A,0C0H
	LD D,(IY+9)
	LD E,(IY+8)
	JR SB_RESTZAHL
SB_OK:
	LD A,80H
	LD D,(IY+7)
	LD E,(IY+6)
SB_RESTZAHL:
	LD H,(IY+5)
	LD L,(IY+4)
	XOR A
	SBC HL,BC
	LD (IY+5),H
	LD (IY+4),L
	LD (IY+10),A
	LD (V_SIO_RUECK),DE
	LD IY,(V_SIO_IY2)
	XOR A
	RET
ISR_SIO_A_TX:
	CALL REGS_RETTEN
	CALL SIO_BYTE
	JR Z,IST_FERTIG
	CALL REGS_HOLEN
	EI
	RETI
IST_FERTIG:
	LD A,28H
	OUT (51H),A
	CALL REGS_HOLEN
	PUSH HL
	LD HL,(V_SIO_RUECK)
	EX (SP),HL
	EI
	RETI
ISR_SIO_B_TX:
	CALL REGS_RETTEN
	CALL SIO_BYTE
	JR Z,IST_FERTIG
	CALL REGS_HOLEN
	EI
	RETI
V_SIO_ZEIGER:
	DB	00H,00H
V_SIO_REST:
	DB	0C8H,00H
V_SIO_IY:
	DB	00H,00H
V_SIO_IY2:
	DB	00H,00H
V_SIO_RUECK:
	DB	00H,00H
	FILLFF	208
; ==========================================================================
; CP/A support (plan 48 C3.2): BIOS jump list, console output/input, fatal halt
; ==========================================================================
; The BIOS entry points are never fixed addresses: BIOS_LINK reads WBOOT = (0001H) once at the
; start and fills this jump list (offsets of CP/A bios.mac: CONST +3, CONIN +6, CONOUT +9, LIST +0CH,
; HOME +15H, SELDSK +18H, SETTRK +1BH, SETSEC +1EH, SETDMA +21H, READ +24H, WRITE +27H).
; (0001H) is never read again: the BIOS overwrites it during floppy transfers.
; Before BIOS_LINK every slot points to STOP, so an early call just halts.
B_CONST:
	JP STOP
B_CONIN:
	JP STOP
B_CONOUT:
	JP STOP
B_LIST:
	JP STOP
B_HOME:
	JP STOP
B_SELDSK:
	JP STOP
B_SETTRK:
	JP STOP
B_SETSEC:
	JP STOP
B_SETDMA:
	JP STOP
B_READ:
	JP STOP
B_WRITE:
	JP STOP
TAB_BIOS_OFF:
	DB	03H,06H,09H,0CH,15H,18H,1BH,1EH,21H,24H,27H
NBIOS	EQU	11
V_WBOOT:
	DW	0000H
; BIOS_LINK: slot address field := WBOOT + offset; WBOOT must be BIOS start + 3 (BIOS starts on a page boundary)
BIOS_LINK:
	LD HL,(0001H)
	LD (V_WBOOT),HL
	LD A,L
	CP 03H
	JR Z,LK_OK
	LD A,'W'
	JP FEHLERHALT
LK_OK:
	LD IX,TAB_BIOS_OFF
	LD DE,B_CONST+1
	LD B,NBIOS
LK_SCHL:
	LD HL,(V_WBOOT)
	LD C,(IX+0)
	PUSH BC
	LD B,00H
	ADD HL,BC
	POP BC
	EX DE,HL		; DE = target, HL = slot address field
	LD (HL),E
	INC HL
	LD (HL),D
	INC HL
	INC HL			; next slot address field
	EX DE,HL
	INC IX
	DJNZ LK_SCHL
	RET
; CHECK_I: the interrupt vector table of CP/A is at F700H (I = F7H); anything else: fatal
CHECK_I:
	LD A,I
	CP 0F7H
	RET Z
	LD A,'I'
	JP FEHLERHALT
; KBD_FLUSH: empty the BIOS keyboard buffer (the M8KBOOT command line may have left keys)
KBD_FLUSH:
	CALL B_CONST
	OR A
	RET Z
	CALL B_CONIN
	JR KBD_FLUSH
; PUTC: character A to the BIOS console (CONOUT); keeps AF, BC, DE, HL, IX, IY
PUTC:
	PUSH AF
	PUSH BC
	PUSH DE
	PUSH HL
	PUSH IX
	PUSH IY
	LD C,A
	CALL B_CONOUT
	POP IY
	POP IX
	POP HL
	POP DE
	POP BC
	POP AF
	RET
; NEWLINE: CR LF (the BIOS line feed alone may not return to column 0)
NEWLINE:
	LD A,0DH
	CALL PUTC
	LD A,0AH
	JP PUTC
; PUTS: length byte and text at HL through PUTC; keeps all registers
PUTS:
	PUSH AF
	PUSH BC
	PUSH HL
	LD B,(HL)
	INC HL
	LD A,B
	OR A
	JR Z,PS_ENDE
PS_ZEICHEN:
	LD A,(HL)
	CALL PUTC
	INC HL
	DJNZ PS_ZEICHEN
PS_ENDE:
	POP HL
	POP BC
	POP AF
	RET
; GETC: key poll like UDOS 0BE8H: Z = no key, else A = key (CP/A code, waits for nothing);
; a key with code 00H counts as "no key".  Keeps BC, DE, HL, IX, IY.
GETC:
	PUSH BC
	PUSH DE
	PUSH HL
	PUSH IX
	PUSH IY
	CALL B_CONST
	OR A
	JR Z,GC_ENDE
	CALL B_CONIN
	OR A
GC_ENDE:
	POP IY
	POP IX
	POP HL
	POP DE
	POP BC
	RET
; FEHLERHALT: fatal error, A = code character: 'W' WBOOT not BIOS start + 3, 'I' register I not F7H,
; 'B' busy DCB hit by a second request, 'L' disk request longer than 1000H.
; Message, interrupts off, endless halt.  (Replaces RST 38H, which leads to a CP/A warm start.)
FEHLERHALT:
	DI
	PUSH AF
	CALL NEWLINE
	LD HL,T_FATAL
	CALL PUTS
	POP AF
	CALL PUTC
; STOP: also the target of unlinked BIOS slots
STOP:
	DI
	HALT
	JR STOP
T_FATAL:
	DB	T_FATALE-T_FATAL-1
	DB	'mutoscpa: fatal error '
T_FATALE:
; --- MASKE: Bedienmaske beim Start: Laufwerk -> rk-Nummer (Entwurf 39 Abschnitt 11.4) --------
; Zeigt 'floppy - drive 0 1 2 3' / 'mutos - rk 0 1 2 3', Eingabe pro Spalte 0-3, 'r' = weiter.
; Ergebnis: TAB_RK_LAUFWERK[rk] = Laufwerk.  Texts: length-prefixed strings (output with PUTS);
; the three error texts are 30 bytes each (MELDUNG_AUSGEBEN: new line + text through PUTC).
MASKE:
	JP MASKE_START
T_STRICH:
	DB	25H
	DB	'- - - - - - - - - - - - - - - - - - -'
T_FLOPPY:
	DB	25H
	DB	'floppy - drive......:   0   1   2   3'
T_RK:
	DB	25H
	DB	'mutos  - rk.........:   '
T_FLOPPY_ZIFFER0:
	DB	'0   '
T_RK_ZIFFER0:
	DB	'1   '
T_RK_ZIFFER1:
	DB	'2   '
T_RK_ZIFFER2:
	DB	'3'
T_WECHSEL:
	DB	15H
	DB	'change / ready (r)..:'
T_BOOT_ENTF:
	DB	1CH
	DB	'remove mutos8000 boot - disk'
T_WURZEL_EINL:
	DB	23H
	DB	'insert mutos8000 root - disk on rk2'
; Error texts (30 bytes each, written by MELDUNG_AUSGEBEN)
T_FEHL_NICHT_ZUGEORDNET:
	DB	'* * error : not assign rk  * *'
T_FEHL_ZAHL:
	DB	'* * error : number (0...3) * *'
T_FEHL_DOPPELT:
	DB	'* * error : rk - duplikate * *'
; Eingabepuffer der Maske (4 Byte), danach TAB_RK_LAUFWERK (rk -> Laufwerk), letzte Taste,
; und die Adressen der Ziffern in den Textzeilen
V_EINGABE:
	DB	00H,01H,02H,03H
TAB_RK_LAUFWERK:
	DB	00H,01H,02H,03H
V_LETZTE_TASTE:
	DB	00H
TAB_ZEIGER:
	DW	T_FLOPPY_ZIFFER0
	DW	T_RK_ZIFFER0
	DW	T_RK_ZIFFER1
	DW	T_RK_ZIFFER2
MASKE_START:
	CALL MASKE_KOPF1
MASKE_NEU:
	LD HL,V_EINGABE
	LD BC,0400H
M_INIT_SCHL:
	LD (HL),C
	INC C
	INC HL
	DJNZ M_INIT_SCHL
MASKE_ZEILE:
	CALL MASKE_KOPF2
	CALL NEWLINE
	LD HL,T_WECHSEL
	CALL PUTS
	XOR A
	LD (V_LETZTE_TASTE),A
	LD HL,V_EINGABE
	LD BC,0478H
M_SPALTE:
	LD A,20H
	CALL PUTC
	CALL PUTC
	CALL PUTC
M_TASTE:
	CALL GETC
	JR Z,M_TASTE
	CP 0DH
	JR NZ,M_ECHO
	LD A,(HL)
	AND 7FH
	OR 30H
M_ECHO:
	CALL PUTC
	CP 78H
	JR NZ,M_PRUEF_R
	LD HL,T_FEHL_NICHT_ZUGEORDNET
	CALL MELDUNG_AUSGEBEN
	JP MASKE_NEU
M_PRUEF_R:
	CP 52H
	JR Z,M_R
	CP 72H
	JR NZ,M_PRUEF_ZIFFER
M_R:
	LD E,A
	LD A,(V_LETZTE_TASTE)
	AND A
	JP Z,M_FERTIG
	LD A,E
M_PRUEF_ZIFFER:
	LD E,A
	AND 0CCH
	JR Z,M_ZIFFER
	LD HL,T_FEHL_ZAHL
	CALL MELDUNG_AUSGEBEN
	JP MASKE_NEU
M_ZIFFER:
	LD A,E
	LD (V_LETZTE_TASTE),A
	AND 03H
	LD E,A
	PUSH HL
	LD HL,V_EINGABE
	LD D,00H
	ADD HL,DE
	BIT 7,(HL)
	JR Z,M_NEUE_ZUORD
	POP HL
	LD HL,T_FEHL_DOPPELT
	CALL MELDUNG_AUSGEBEN
	JP MASKE_NEU
M_NEUE_ZUORD:
	BIT 6,(HL)
	JR NZ,M_BELEGT
	LD (HL),C
M_BELEGT:
	SET 7,(HL)
	POP HL
	LD E,A
	LD A,(HL)
	AND 80H
	OR E
	SET 6,A
	LD (HL),A
	INC HL
	DJNZ M_SPALTE
	LD HL,V_EINGABE
	LD B,04H
	LD DE,TAB_ZEIGER
M_UEBERNEHMEN:
	LD A,(HL)
	AND 03H
	LD (HL),A
	OR 30H
	PUSH HL
	EX DE,HL
	LD E,(HL)
	INC HL
	LD D,(HL)
	INC HL
	EX DE,HL
	LD (HL),A
	POP HL
	INC HL
	DJNZ M_UEBERNEHMEN
	JP MASKE_ZEILE
M_FERTIG:
	LD HL,V_ANGEM
	LD DE,V_ANGEM+1
	LD BC,0007H
	LD (HL),00H
	LDIR			; drives are logged in again at the first access
	LD DE,V_EINGABE
	LD BC,0400H
M_TAB_SCHL:
	LD A,(DE)
	PUSH DE
	LD D,00H
	LD E,A
	LD HL,TAB_RK_LAUFWERK
	ADD HL,DE
	LD (HL),C
	POP DE
	INC C
	INC DE
	DJNZ M_TAB_SCHL
	CALL NEWLINE
	CALL NEWLINE
	CALL SIGNALTON
	RET
MASKE_KOPF1:
	CALL NEWLINE
	CALL NEWLINE
	CALL NEWLINE
	CALL NEWLINE
	CALL NEWLINE
	CALL NEWLINE
	LD HL,T_STRICH
	CALL PUTS
	CALL NEWLINE
	CALL NEWLINE
	LD HL,T_BOOT_ENTF
	CALL PUTS
	CALL NEWLINE
	LD HL,T_WURZEL_EINL
	CALL PUTS
	CALL NEWLINE
	CALL NEWLINE
	LD HL,T_STRICH
	CALL PUTS
	RET
MASKE_KOPF2:
	CALL NEWLINE
	CALL NEWLINE
	CALL NEWLINE
	CALL NEWLINE
	LD HL,T_STRICH
	CALL PUTS
	CALL NEWLINE
	LD HL,T_FLOPPY
	CALL PUTS
	CALL NEWLINE
	LD HL,T_RK
	CALL PUTS
	CALL NEWLINE
	LD HL,T_STRICH
	CALL PUTS
	RET
; Message (30 bytes at HL): new line, text through PUTC, then the beep on the keyboard
MELDUNG_AUSGEBEN:
	CALL NEWLINE
	LD B,1EH
MA_ZEICHEN:
	LD A,(HL)
	CALL PUTC
	INC HL
	DJNZ MA_ZEICHEN
SIGNALTON:
	LD A,07H
	OUT (5CH),A
	XOR A
	OUT (5CH),A
	RET
SEG9400E:
	REPT	(100H-(($-SEG9400) AND 0FFH)) AND 0FFH
	DB	0FFH
	ENDM
	.DEPHASE

; ---- Segment A400H .. A5A7H ----
	.PHASE	SEG3_BASE
SEGA400:
; ==== Segment A400: Arbeitsdaten (Vorbesetzung der Datei) ====
; V_KLASSE (Index 0,2,4,6,8), V_AKTUELL (Zeiger auf den laufenden Beschreiber), V_ANFRAGE_EINTRAG,
; KLASSEN = 5 Beschreiber a 4 Byte [Anforderungsmaske, Fertigmaske, Zeiger Handlertabelle],
; Handlertabellen TAB_KL0..4 (8 x [DCB, Handler]), 7 DCBs a 23 Byte, 6 Nukleus-Auftraege a 13 Byte.
V_KLASSE:
	DB	00H
V_AKTUELL:
	DW	KLASSEN
V_ANFRAGE_EINTRAG:
	DW	KLASSEN
KLASSEN:
	DB	00H
KLASSE0_MELDUNG:
	DB	00H
	DW	TAB_KL0
	DB	00H
KLASSE1_MELDUNG:
	DB	00H
	DW	TAB_KL1
	DB	00H
KLASSE2_MELDUNG:
	DB	00H
	DW	TAB_KL2
	DB	00H,00H
	DW	TAB_KL3
	DB	00H,00H
	DW	TAB_KL4
TAB_KL0:
	DW	DCB0
	DW	PLATTE
	DW	DCB0
	DW	PLATTE
	DW	DCB0
	DW	PLATTE
	DW	DCB0
	DW	PLATTE
	DW	DCB0
	DW	PLATTE
	DW	DCB0
	DW	PLATTE
	DW	DCB0
	DW	PLATTE
	DW	DCB0
	DW	PLATTE
TAB_KL1:
	DW	DCB1
	DW	DRUCKER
	DW	DCB1
	DW	IGNORIEREN
	DW	DCB1
	DW	IGNORIEREN
	DW	DCB1
	DW	IGNORIEREN
	DW	DCB1
	DW	IGNORIEREN
	DW	DCB1
	DW	IGNORIEREN
	DW	DCB1
	DW	IGNORIEREN
	DW	DCB1
	DW	IGNORIEREN
TAB_KL3:
	DW	DCB2
	DW	ROH
	DW	DCB2
	DW	IGNORIEREN
	DW	DCB2
	DW	IGNORIEREN
	DW	DCB2
	DW	IGNORIEREN
	DW	DCB2
	DW	IGNORIEREN
	DW	DCB2
	DW	IGNORIEREN
	DW	DCB2
	DW	IGNORIEREN
	DW	DCB2
	DW	IGNORIEREN
TAB_KL2:
	DW	DCB3
	DW	KONSOLE_AUS
	DW	DCB4
	DW	TTY1_AUS
	DW	DCB5
	DW	TTY2_AUS
	DW	DCB6
	DW	TTY3_AUS
	DW	DCB3
	DW	IGNORIEREN
	DW	DCB3
	DW	IGNORIEREN
	DW	DCB3
	DW	IGNORIEREN
	DW	DCB3
	DW	IGNORIEREN
TAB_KL4:
	DW	AUF0
	DW	EING_TASTE
	DW	AUF0
	DW	EING_TTY1
	DW	AUF0
	DW	EING_TTY2
	DW	AUF0
	DW	EING_TTY3
	DW	AUF0
	DW	IGNORIEREN
	DW	AUF0
	DW	IGNORIEREN
	DW	AUF0
	DW	IGNORIEREN
	DW	AUF0
	DW	IGNORIEREN
; DCBs: +0 vector, +1 level, +2/3 Z80 buffer, +4/5 EM address of the message, +6..19 message copy,
; +20/21 count, +22 bit 0 'request running'.  DCB0 disk, DCB1 printer, DCB2 raw floppy,
; DCB3 console, DCB4..6 tty1..3.
DCB0:
	DB	0AH,05H
	DW	BUF_DISK
	DB	0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH
	DB	0FFH,0FFH,0FFH,0FFH,00H,00H,00H
DCB1:
	DB	12H,04H
	DW	BUF_LIST
	DB	0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH
	DB	0FFH,0FFH,0FFH,0FFH,00H,00H,00H
DCB2:
	DB	1AH,05H
	DW	BUF_RAWFD
	DB	0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH
	DB	0FFH,0FFH,0FFH,0FFH,00H,00H,00H
DCB3:
	DB	24H,04H
	DW	BUF_CONS
	DB	0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH
	DB	0FFH,0FFH,0FFH,0FFH,00H,00H,00H
DCB4:
	DB	28H,04H
	DW	BUF_TTY1
	DB	0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH
	DB	0FFH,0FFH,0FFH,0FFH,00H,00H,00H
DCB5:
	DB	2CH,04H
	DW	BUF_TTY2
	DB	0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH
	DB	0FFH,0FFH,0FFH,0FFH,00H,00H,00H
DCB6:
	DB	30H,04H
	DW	BUF_TTY3
	DB	0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH
	DB	0FFH,0FFH,0FFH,0FFH,00H,00H,00H
; AUF0..AUF5: request blocks (IY) for the nucleus resp. the drivers, 13 bytes each
AUF0:
	DB	00H,0AH
	DW	BUF_DISK
AUF0_STATUS1:
	DB	00H
AUF0_STATUS2:
	DB	02H,00H,00H,00H,00H
AUF0_STATUS3:
	DB	00H,00H,00H
AUF1:
	DB	00H,0EH
	DW	BUF_LIST
	DB	00H,00H,00H,00H,00H,00H
AUF1_STATUS:
	DB	00H,00H,00H
AUF2:
	DB	00H,0EH
	DW	BUF_RAWFD
	DB	00H,00H,00H,00H,00H,00H,00H,00H,00H
AUF3:
	DB	01H,0EH
	DW	BUF_TTY1
	DB	00H,00H,00H,00H,00H,00H
AUF3_STATUS:
	DB	00H,00H,00H
AUF4:
	DB	02H,0EH
	DW	BUF_TTY2
	DB	00H,00H,00H,00H,00H,00H
AUF4_STATUS:
	DB	00H,00H,00H
AUF5:
	DB	00H,0EH
	DW	BUF_TTY3
	DB	00H,00H,00H,00H,00H,00H
AUF5_STATUS:
	DB	00H,00H,00H
SEGA400E:
	REPT	(100H-(($-SEGA400) AND 0FFH)) AND 0FFH
	DB	0FFH
	ENDM
	.DEPHASE

; ---- Segment C8B6H .. C967H ----
	.PHASE	SEG4_BASE
SEGC8B6:
; ==== Segment C8B6: Warteschlangen (je 44 Byte: Tastatur, tty1, tty2, tty3) und Zaehler ====
QUEUE_TASTE:
	DB	04H,04H,00H,00H,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH
	FILLFF	28
QUEUE_TTY1:
	DB	04H,04H,00H,00H,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH
	FILLFF	28
QUEUE_TTY2:
	DB	04H,04H,00H,00H,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH
	FILLFF	28
QUEUE_TTY3:
	DB	04H,04H,00H,00H,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH,0FFH
	FILLFF	28
; V_TAKT: counter of the timer ticks; the byte after it (UDOS V_BUSY, unused since C3.3) is kept as filler so that
; segment 4 and the image length (C967H) stay as before
V_TAKT:
	DB	01H
	DB	0FFH
SEGC8B6E:
	REPT	(100H-(($-SEGC8B6) AND 0FFH)) AND 0FFH
	DB	0FFH
	ENDM
	.DEPHASE
	END
