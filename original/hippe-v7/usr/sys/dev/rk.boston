#
/*
 * RK disk driver
 * Originally from Boston Children's Museum.
 */
#include "../h/param.h"
#include "../h/systm.h"
#include "../h/buf.h"
#include "../h/dir.h"
#include "../h/conf.h"
#include "../h/user.h"

#define RKADDR	((struct device *)0177400)
#define NRK	4
#define NSECT	12
#define NTRACK	2
#define NBLK	4872

#define NSKIP   10
#define IFAC	2
#define NRETRY	10

#define RESET	0
#define WCOM	2
#define RCOM	4
#define GO	01
#define SEEK	010
#define DRESET	014
#define IENABLE	0100
#define CTLRDY	0200
#define SEEKINC	01000
#define SEEKCMP 020000

#define RKERRS	0120340

#define OSEEKS

struct device {
	int	rkds;
	int	rker;
	int	rkcs;
	int	rkwc;
	caddr_t	rkba;
	int	rkda;
};

struct buf rktab;
struct buf rrkbuf;

struct rk {
	struct buf *ioqp;
	int	lastcyl;
	char	headdir;
	char	seeking;
	int	errcnt;
} rk[NRK];

struct rk *rkio;

/*
 * note the assumption that a
 * pointer is at least two bytes
 * long
 * I don't like this, and neither
 * does `lint', but ....
 */
union {
	char	byte[2];
	struct buf *ubp;
};

#define cylin	b_resid
#define sector	av_back.byte[0]
#define track	av_back.byte[1]
#define skip	b_error

#define IN	1	/* head direction */
#define OUT	0

#define DK_N	1

rkopen()
{
}

rkclose()
{
}

rkstrategy(bp)
register struct buf *bp;
{
	register struct rk *qp;
	register unsigned bn;
	int dev;

	dev = minor(bp->b_dev);
	if(((bn = bp->b_blkno) > NBLK) || (dev > NRK)){
		bp->b_flags |= B_ERROR;
		iodone(bp);
		return;
	}
	bp->av_forw = 0;
	bp->skip = NSKIP;
	bp->sector = bn%NSECT;
	bp->cylin = bn/NSECT;
	bp->track = bp->cylin&01;
	bp->cylin >>= 1;
	qp = &rk[dev];
	spl5();
	if(qp->ioqp == NULL){
		qp->ioqp = bp;
		if((rkio == NULL) && (RKADDR->rkcs&CTLRDY))
			rkstart();
	}
	else
		xsort(bp, qp->ioqp, qp->headdir, IFAC);
	spl0();
}

rkstart()
{
	register struct buf *bp;
	register struct rk *qp;
#ifndef OSEEKS
	register int n;
#endif OSEEKS

	for(qp = rk; qp < &rk[NRK]; qp++){
#ifdef OSEEKS
		if((bp = qp->ioqp) && (qp->seeking == 0)){
#else
		if(bp = qp->ioqp){
#endif OSEEKS
			if(bp->cylin > qp->lastcyl)
				qp->headdir = 1;
			else if(bp->cylin < qp->lastcyl)
				qp->headdir = 0;
#ifdef OSEEKS
			qp->seeking++;
			while((RKADDR->rkcs&CTLRDY) == 0)
				;
			RKADDR->rkda = (bp->b_dev << 13)|(bp->cylin << 5)|(bp->track << 4)|(bp->sector);
			RKADDR->rkcs = IENABLE|SEEK|GO;
#ifdef INSTRM
			dk_busy |= 1<<DK_N;
#endif INSTRM
#else
			qp->lastcyl = bp->cylin;
			rkio = qp;
			bp->skip = 0;
			RKADDR->rkda = (bp->b_dev << 13)|(bp->cylin << 5)|(bp->track << 4)|(bp->sector);
			RKADDR->rkba = bp->b_un.b_addr;
			RKADDR->rkwc = -(bp->b_bcount >> 1);
			n = ((bp->b_xmem&03) << 4)|IENABLE|GO;
			if(bp->b_flags&B_READ)
				n |= RCOM;
			else
				n |= WCOM;
			RKADDR->rkcs = n;
#ifdef INSTRM
			dk_busy |= 1<<DK_N;
			dk_numb[DK_N] += 1;
			n = bp->b_bcount >> 6;
			dk_wds[DK_N] += n;
#endif INSTRM
			return;
#endif OSEEKS
		}
	}
}

rkintr()
{
	register int n;
	register struct rk *qp;
	register struct buf *bp;
	int error;
#ifdef OSEEKS
	int dreset;
#endif OSEEKS

#ifdef INSTRM
	dk_busy &= ~(1 << DK_N);
#endif INSTRM
	if(RKADDR->rkcs < 0){
		error = RKADDR->rker;
		if(rkio)
			deverror(rkio->ioqp, error, RKADDR->rkds);
#ifdef OSEEKS
		for(qp = rk; qp < &rk[NRK]; qp++)
			if(qp->ioqp)
				qp->seeking = 0;
		if(RKADDR->rkds&SEEKINC){
			n = (RKADDR->rkds >> 13)&07;
			RKADDR->rkda = n<<13;
			RKADDR->rkcs = IENABLE|DRESET|GO;
			dreset = 1;
		}
		else {
#endif OSEEKS
			n = (RKADDR->rkda >> 13)&07;
			RKADDR->rkcs = IENABLE|RESET|GO;
#ifdef OSEEKS
			dreset = 0;
		}
#endif OSEEKS
		qp = &rk[n];
		bp = qp->ioqp;
		if((++(qp->errcnt) >= NRETRY) || (error&RKERRS)){
			bp->b_flags |= B_ERROR;
			goto out;
		}
#ifdef OSEEKS
		if(dreset)
			return;
#endif OSEEKS
		while((RKADDR->rkcs&CTLRDY) == 0)
			;
#ifdef OSEEKS
		goto xfer;
#else
		rkstart();
#endif OSEEKS
	}
#ifdef OSEEKS
	if(RKADDR->rkcs&SEEKCMP){
		n = (RKADDR->rkds >> 13)&07;
		if(n >= NRK || rkio){
			printf("\nrk botch\n");
			return;
		}
		bp = (qp = &rk[n])->ioqp;
		if(qp->seeking){
			qp->seeking = 0;
		xfer:
			qp->lastcyl = bp->cylin;
			rkio = qp;
			bp->skip = 0;
			RKADDR->rkda = (bp->b_dev << 13)|(bp->cylin << 5)|(bp->track << 4)|(bp->sector);
			RKADDR->rkba = bp->b_un.b_addr;
			RKADDR->rkwc = -(bp->b_bcount >> 1);
			n = ((bp->b_xmem&03) << 4)|IENABLE|GO;
			if(bp->b_flags&B_READ)
				n |= RCOM;
			else
				n |= WCOM;
			RKADDR->rkcs = n;
#ifdef INSTRM
			dk_busy |= 1<<DK_N;
			dk_numb[DK_N] += 1;
			n = bp->b_bcount >> 6;
			dk_wds[DK_N] += n;
#endif INSTRM
		}
	}
#endif OSEEKS
	else {
		if(qp = rkio){
			bp = qp->ioqp;
		out:
			qp->ioqp = bp->av_forw;
			rkio = NULL;
			qp->errcnt = 0;
			bp->b_resid = 0;
			rkstart();
			iodone(bp);
		}
	}
}

rkread(dev)
{
	physio(rkstrategy, &rrkbuf, dev, B_READ);
}

rkwrite(dev)
{
	physio(rkstrategy, &rrkbuf, dev, B_WRITE);
}
