# Entwurf 39 Abschnitt 11.2: DISK-Satz (8 x 512 B) mit gepatchtem mutos_io und ZDOS (Suche nur Einheit 0).
# Aufruf aus dem Wurzelverzeichnis des Projekts (Ladediskette vorher bauen, siehe Abschnitt 11.7):
#   tools/emu.py dbg --em em256 --laufwerke K5601,K5601,K5601 lade_8x512.hfe \
#       -b @REPO@/disks/original/a5120_mutos8000_cc1.td0 -c @REPO@/disks/original/a5120_mutos8000_root.td0 \
#       -x versuche/dbg/geometrie_8x512.dbg
# B: (CC1) und C: (ROOT) liegen schon beim Start in den Laufwerken: das geht nur mit dem ZDOS-Patch.
g 80000000
keys BOOT\sMUTOS\r
g 100000000
keys r
g 100000000
keys root\r
g 100000000
keys ls\s-l\s/\r
g 100000000
keys /bin/mount\s/dev/rk1\s/usr\r
g 100000000
keys ls\s-l\s/usr/bin\r
g 100000000
screen
q
