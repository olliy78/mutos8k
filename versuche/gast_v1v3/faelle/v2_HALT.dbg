# V2 HALT: overwrite the first user instruction of cat with a privileged instruction   (generated by gen_faelle.sh)
# Kernel entries logged at function entry ([SP+2]w/[SP+4]w = first two arguments):
# 087A trap(dev,ident)  0B6E psignal(p,sig)  0C7C psig  0D56 core  48C4 exit(rv)  3630 sigret  35AE sendsig(p,n)  4BD0 sbreak
# Kernel data: u at FC00 in segment 0 (raw cells em:0FC00..), u_dsize FCAA, u_signal[n] FCD2+2n.
cpu u8000
trap clear
b <<1>>%0000
b <<2>>%0000
b <<3>>%0000
keys cat\r
g 60000000
r
bd <<1>>%0000
bd <<2>>%0000
bd <<3>>%0000
e %0000 7A 00
u %0000 2
lp <<0>>%087A [SP+2]w [SP+4]w
lp <<0>>%0B6E [SP+2]w [SP+4]w
lp <<0>>%0C7C
lp <<0>>%0D56
lp <<0>>%48C4 [SP+2]w
lp <<0>>%3630
lp <<0>>%35AE [SP+2]w [SP+4]w
lp <<0>>%4BD0 [SP+2]w
g 400000000
g 1500000000
r
lpl
trap 3
screen
q
